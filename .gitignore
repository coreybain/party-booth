# ---------------------------------------------------------------------------
# Dependencies
# ---------------------------------------------------------------------------
node_modules/
npm-debug.log*
yarn-error.log*

# ---------------------------------------------------------------------------
# Build output
# ---------------------------------------------------------------------------
dist/
build/
out/
*.tsbuildinfo
.tsbuildinfo

# NOTE: there is deliberately **no** `lib/` rule. Every package here is consumed
# as TypeScript source (see `packages/contracts/README.md`), so nothing ever
# emits a `lib/` build directory — but three real source directories are named
# `lib`: `apps/web/src/lib`, `apps/mobile/src/lib` and
# `packages/backend/convex/lib`. An unanchored `lib/` silently excluded all of
# them, so a fresh clone could not typecheck, test or build. If a package ever
# does emit a compiled `lib/`, ignore it by its exact path.

# ---------------------------------------------------------------------------
# Turborepo
# ---------------------------------------------------------------------------
.turbo/

# ---------------------------------------------------------------------------
# Next.js / Vercel
# ---------------------------------------------------------------------------
.next/
.vercel/
next-env.d.ts

# ---------------------------------------------------------------------------
# Expo / React Native / EAS
# ---------------------------------------------------------------------------
.expo/
.expo-shared/
expo-env.d.ts
ios/
android/
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.orig.*
web-build/

# ---------------------------------------------------------------------------
# Convex
# ---------------------------------------------------------------------------
.convex/
# NOTE: `packages/backend/convex/_generated/` is deliberately NOT ignored.
# It looks like build output but is not: `dataModel.d.ts` is the typed data model
# derived from `schema.ts`, and nothing in packages/backend — or in any app that
# imports it — typechecks without it. The Convex CLI says so in the file header
# it writes. It is also what makes a fresh clone work offline: `convex codegen`
# refuses to run without deployment configuration, so these files must be in git.
# Convex's own local state (deployment name, admin key) lives in
# packages/backend/.env.local and IS ignored, by the .env rules below.

# ---------------------------------------------------------------------------
# Environment — never commit real values. Only .env.example is tracked.
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
.env.local
.env.*.local

# ---------------------------------------------------------------------------
# Test / coverage
# ---------------------------------------------------------------------------
coverage/
.nyc_output/
test-results/
playwright-report/
blob-report/
.playwright/

# ---------------------------------------------------------------------------
# Tooling caches
# ---------------------------------------------------------------------------
.codex/
.eslintcache
.cache/
.temp/
.tmp/

# ---------------------------------------------------------------------------
# Editors / OS
# ---------------------------------------------------------------------------
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
*.swp
