{
  "name": "partybooth",
  "version": "0.1.0",
  "private": true,
  "description": "PartyBooth — private-beta party photo/video sharing. See PLAN.md and TODO.md.",
  "packageManager": "bun@1.3.14",
  "type": "module",
  "engines": {
    "node": ">=26",
    "bun": ">=1.3"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "catalog": {
    "@types/node": "^26.0.0",
    "@vitest/coverage-v8": "^4.1.10",
    "convex": "^1.42.3",
    "eslint": "^10.8.0",
    "prettier": "^3.9.6",
    "typescript": "~6.0.3",
    "uploadthing": "^7.7.4",
    "vitest": "^4.1.10",
    "zod": "^4.4.3"
  },
  "overrides": {
    "expo-constants": "57.0.8"
  },
  "trustedDependencies": [
    "@sentry/cli",
    "@swc/core",
    "core-js",
    "esbuild",
    "sharp",
    "unrs-resolver"
  ],
  "scripts": {
    "build": "bun --env-file=.env.local run turbo run build",
    "dev": "bun --env-file=.env.local run turbo run dev",
    "start": "bun --env-file=.env.local run turbo run dev --filter=@partybooth/backend --filter=@partybooth/web --filter=@partybooth/mobile",
    "start:web": "bun --env-file=.env.local run turbo run dev --filter=@partybooth/backend --filter=@partybooth/web",
    "start:mobile": "bun --env-file=.env.local run turbo run dev --filter=@partybooth/backend --filter=@partybooth/mobile",
    "lint": "eslint . && turbo run lint",
    "lint:fix": "eslint . --fix && turbo run lint -- --fix",
    "typecheck": "tsc --noEmit && turbo run typecheck",
    "test": "turbo run test",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "convex:update": "bun run --cwd=packages/backend convex dev --once --env-file ../../.env.local",
    "env:doctor": "bun scripts/env-doctor.mjs",
    "verify:app-links": "bun scripts/verify-app-links.mjs",
    "seed:demo": "bun scripts/seed-demo.mjs",
    "icons": "bun scripts/make-icons.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "turbo run typecheck lint test",
    "clean": "turbo run clean && rm -rf node_modules .turbo"
  },
  "devDependencies": {
    "@partybooth/config-eslint": "workspace:*",
    "@partybooth/config-typescript": "workspace:*",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "eslint": "catalog:",
    "prettier": "catalog:",
    "turbo": "^2.10.7",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "patchedDependencies": {
    "expo-modules-jsi@57.0.4": "patches/expo-modules-jsi@57.0.4.patch"
  }
}
