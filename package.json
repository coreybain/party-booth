{
  "name": "partybooth",
  "version": "0.1.0",
  "private": true,
  "description": "PartyBooth — private-beta party photo/video sharing. See PLAN.md and TODO.md.",
  "packageManager": "pnpm@10.19.0",
  "type": "module",
  "engines": {
    "node": ">=26",
    "pnpm": ">=10"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "eslint . && turbo run lint",
    "lint:fix": "eslint . --fix && turbo run lint -- --fix",
    "typecheck": "tsc --noEmit && turbo run typecheck",
    "test": "turbo run test",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "env:doctor": "node scripts/env-doctor.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "turbo run typecheck lint test",
    "clean": "turbo run clean && rm -rf node_modules .turbo"
  },
  "devDependencies": {
    "@partybooth/config-eslint": "workspace:*",
    "@partybooth/config-typescript": "workspace:*",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "eslint": "catalog:",
    "prettier": "catalog:",
    "turbo": "^2.10.7",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
