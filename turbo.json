{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "stream",
  "globalDependencies": [
    "bun.lock",
    "bunfig.toml",
    "package.json",
    "tsconfig.json",
    "prettier.config.mjs",
    ".env.example",
    "packages/config-typescript/*.json",
    "packages/config-eslint/*.js"
  ],
  "globalEnv": ["NODE_ENV", "CI", "VERCEL", "VERCEL_ENV", "EAS_BUILD"],
  "globalPassThroughEnv": [
    "npm_lifecycle_event",
    "TURBO_*",
    "SENTRY_AUTH_TOKEN",
    "CONVEX_DEPLOY_KEY",
    "EXPO_TOKEN"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**", ".expo/**", "storybook-static/**"],
      "env": [
        "NEXT_PUBLIC_*",
        "EXPO_PUBLIC_*",
        "CONVEX_*",
        "BETTER_AUTH_*",
        "GOOGLE_CLIENT_*",
        "APPLE_*",
        "RESEND_*",
        "UPLOADTHING_*",
        "UPLOAD_CALLBACK_SECRET",
        "DEPLOYMENT_ENVIRONMENT",
        "SENTRY_*",
        "ADMIN_EMAIL_ALLOWLIST",
        "DEMO_LOGIN_*",
        "STORAGE_DEFAULT_REGION",
        "EAS_PROJECT_ID"
      ]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true,
      "env": [
        "NEXT_PUBLIC_*",
        "EXPO_PUBLIC_*",
        "CONVEX_*",
        "BETTER_AUTH_*",
        "GOOGLE_CLIENT_*",
        "APPLE_*",
        "RESEND_*",
        "UPLOADTHING_*",
        "UPLOAD_CALLBACK_SECRET",
        "DEPLOYMENT_ENVIRONMENT",
        "SENTRY_*",
        "ADMIN_EMAIL_ALLOWLIST",
        "DEMO_LOGIN_*",
        "STORAGE_DEFAULT_REGION",
        "EAS_PROJECT_ID"
      ]
    },
    "lint": {
      "dependsOn": ["^topo"],
      "outputs": []
    },
    "typecheck": {
      "dependsOn": ["^topo", "^build"],
      "outputs": ["*.tsbuildinfo"]
    },
    "test": {
      "dependsOn": ["^topo"],
      "outputs": [],
      "inputs": ["src/**", "tests/**", "convex/**", "vitest.config.*", "package.json"]
    },
    "test:e2e": {
      "dependsOn": ["^build"],
      "cache": false,
      "outputs": ["playwright-report/**", "test-results/**"]
    },
    "clean": {
      "cache": false
    },
    "topo": {
      "dependsOn": ["^topo"]
    }
  }
}
