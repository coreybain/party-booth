{
  "cli": {
    "version": ">= 21.0.0",
    "appVersionSource": "remote",
    "requireCommit": false
  },
  "build": {
    "base": {
      "env": {
        "EXPO_NO_TELEMETRY": "1",
        "EXPO_OWNER": "spiritdevs",
        "EXPO_PUBLIC_CONVEX_URL": "https://glad-emu-190.convex.cloud",
        "EXPO_PUBLIC_EAS_PROJECT_ID": "d05e1c88-901c-43a2-afc8-8e20b3abbd0a",
        "EXPO_PUBLIC_SITE_URL": "https://www.partybooth.dev"
      },
      "android": {
        "image": "latest"
      },
      "ios": {
        "image": "latest"
      }
    },
    "development": {
      "extends": "base",
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "environment": "development",
      "android": {
        "buildType": "apk",
        "resourceClass": "medium"
      },
      "ios": {
        "resourceClass": "m-medium"
      }
    },
    "development-simulator": {
      "extends": "development",
      "ios": {
        "simulator": true,
        "resourceClass": "m-medium"
      }
    },
    "internal": {
      "extends": "base",
      "developmentClient": false,
      "distribution": "store",
      "channel": "internal",
      "environment": "preview",
      "autoIncrement": true,
      "android": {
        "buildType": "app-bundle",
        "resourceClass": "medium"
      },
      "ios": {
        "resourceClass": "m-medium"
      }
    },
    "production": {
      "extends": "base",
      "developmentClient": false,
      "distribution": "store",
      "channel": "production",
      "environment": "production",
      "autoIncrement": true,
      "android": {
        "buildType": "app-bundle",
        "resourceClass": "medium"
      },
      "ios": {
        "resourceClass": "m-medium"
      }
    }
  },
  "submit": {
    "internal": {
      "android": {
        "track": "internal",
        "releaseStatus": "draft",
        "changesNotSentForReview": false,
        "serviceAccountKeyPath": "$GOOGLE_SERVICE_ACCOUNT_KEY_PATH"
      },
      "ios": {
        "ascAppId": "6797317089"
      }
    },
    "production": {
      "android": {
        "track": "production",
        "releaseStatus": "draft",
        "serviceAccountKeyPath": "$GOOGLE_SERVICE_ACCOUNT_KEY_PATH"
      },
      "ios": {
        "ascAppId": "6797317089"
      }
    }
  }
}
