# apps/mobile — Expo environment
#
# Copy to `apps/mobile/.env.local` and fill in. Expo reads env files from the app
# directory only, which is why this file exists alongside the repo-root `.env.example`
# (the root file remains the canonical list — run `pnpm env:doctor` to see it).
#
# EXPO_PUBLIC_* values are inlined into the JS bundle at build time, so:
#   - they are PUBLIC. Never put a secret behind an EXPO_PUBLIC_ prefix.
#   - changing one requires restarting the dev server; a reload is not enough.
#
# The app boots without any of these and shows a "not configured" screen listing what is
# missing, so a fresh checkout runs before Corey has finished the provider setup.

# ── Required ──────────────────────────────────────────────────────────────────────────

# Convex deployment URL, e.g. https://acute-lynx-123.convex.cloud
# Convex dashboard → your deployment → Settings → URL. Same value as CONVEX_URL.
# The Better Auth base URL (*.convex.site) is derived from this unless
# EXPO_PUBLIC_CONVEX_SITE_URL is set explicitly — see src/lib/config.ts.
EXPO_PUBLIC_CONVEX_URL=

# Public website origin, e.g. https://partybooth.app
# Same value as SITE_URL. Used for the universal-link host in app.config.ts, so it must
# match the domain that serves /.well-known/apple-app-site-association and assetlinks.json.
EXPO_PUBLIC_SITE_URL=

# ── Optional: each one degrades to a no-op when unset ─────────────────────────────────

# Convex HTTP-actions origin (*.convex.site) — where Better Auth is mounted.
# Same value as CONVEX_SITE_URL. Leave blank for a hosted Convex deployment: the app
# derives it from EXPO_PUBLIC_CONVEX_URL. Set it when self-hosting or proxying Convex.
EXPO_PUBLIC_CONVEX_SITE_URL=

# Sentry → partybooth-mobile → Client Keys (DSN). Unset = error reporting disabled.
EXPO_PUBLIC_SENTRY_DSN=

# EAS project id (a UUID), written by `eas init`. Unset = push notifications and EAS
# Update are disabled. Same value as EAS_PROJECT_ID.
EXPO_PUBLIC_EAS_PROJECT_ID=

# ── Build-time only (not bundled into the app) ────────────────────────────────────────
# Read by app.config.ts in Node. Set locally for `expo prebuild`, or as EAS environment
# variables for cloud builds.

# Expo account or organisation that owns the EAS project. Unset = uses the logged-in account.
EXPO_OWNER=

# Sentry org/project slugs. BOTH must be set for the source-map upload build step to be
# added; with either missing the Sentry Expo plugin is skipped entirely.
SENTRY_ORG=
SENTRY_PROJECT=
# Only for self-hosted Sentry. Defaults to https://sentry.io/
SENTRY_URL=
# Source-map upload token. Store as an EAS secret, never commit it.
SENTRY_AUTH_TOKEN=
