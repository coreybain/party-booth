    "@expo/vector-icons": "^15.1.1",
    "@partybooth/backend": "workspace:*",
    "@partybooth/contracts": "workspace:*",
    "@partybooth/env": "workspace:*",
    "@sentry/react-native": "~7.11.0",
    "better-auth": "1.6.25",
    "convex": "catalog:",
    "expo": "57.0.8",
    "expo-apple-authentication": "~57.0.1",
    "expo-build-properties": "~57.0.7",
    "expo-camera": "~57.0.3",
    "expo-constants": "~57.0.7",
    "expo-dev-client": "~57.0.9",
    "expo-device": "~57.0.1",
    "expo-image": "~57.0.1",
