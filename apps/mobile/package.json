{
  "name": "@partybooth/mobile",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "main": "expo-router/entry",
  "scripts": {
    "dev": "expo start --dev-client",
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "prebuild": "expo prebuild --clean",
    "build": "expo export --platform all --output-dir dist",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "doctor": "expo-doctor",
    "clean": "rm -rf .expo dist ios android tsconfig.tsbuildinfo",
    "eas:build:dev": "eas build --profile development",
    "eas:build:internal": "eas build --profile internal",
    "eas:build:production": "eas build --profile production"
  },
  "dependencies": {
    "@better-auth/expo": "1.6.25",
