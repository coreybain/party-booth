# =============================================================================
# PartyBooth — the canonical list of every variable in the system.
#
#   cp .env.example .env.local     and fill in the blanks.
#   `.env*` is gitignored except this example, which is the one tracked .env file.
#
# Where each value has to end up:
#   local dev  → .env.local at the repo root, plus apps/mobile/.env.local for
#                anything apps/mobile reads: the EXPO_PUBLIC_* pairs (bundled
#                into the app) and the build-time values apps/mobile/app.config.ts
#                reads in Node (EXPO_OWNER, SENTRY_ORG, SENTRY_PROJECT,
#                SENTRY_URL, SENTRY_AUTH_TOKEN). Expo only reads .env files next
#                to the app, so those never work from the root file — see
#                apps/mobile/.env.example for that side of the split.
#   web        → Vercel → Project → Settings → Environment Variables
#   backend    → Convex dashboard → Settings → Environment Variables
#   app builds → EAS → Project → Secrets (or eas.json `env`)
#
# Nothing here is validated until the code that needs it runs, so you can fill
# this in provider by provider. `bun run env:doctor` prints what is still missing.
# NEVER commit real values. See TODO.md "Notes for Corey" for the dashboards.
# =============================================================================


# -----------------------------------------------------------------------------
# Deployment marker
# -----------------------------------------------------------------------------

# development | preview | production. Set this to `production` in the Convex
# production deployment and in Vercel Production. Safety rails that must not be
# skippable key off this rather than NODE_ENV, which Convex never sets: with no
# explicit marker, the offline email sender would happily print sign-in codes
# into a production log stream. Optional; defaults to development.
DEPLOYMENT_ENVIRONMENT=


# -----------------------------------------------------------------------------
# Site
# -----------------------------------------------------------------------------

# Canonical public origin, no trailing slash. This is the domain the QR codes
# point at, and the origin UploadThing is told to call back on when a file lands
# (unset = detected from the request, which is wrong behind a proxy that
# rewrites Host — every upload then sits in `processing` for ever).
# Local dev: http://localhost:3000. Prod: your purchased domain.
SITE_URL=
# Same value as SITE_URL, exposed to the browser bundle (apps/web).
NEXT_PUBLIC_SITE_URL=
# Same value as SITE_URL, exposed to the Expo bundle (apps/mobile/.env.local).
# The app uploads through the website's /api/uploadthing route handler rather
# than talking to the storage provider itself, so without this the app can take
# photos and queue them but never send them.
EXPO_PUBLIC_SITE_URL=


# -----------------------------------------------------------------------------
# Convex — backend + reactivity. Project region: US East (N. Virginia).
# -----------------------------------------------------------------------------

# Written automatically by `bunx convex dev`; identifies the active dev
# deployment. Leave blank in production.
CONVEX_DEPLOYMENT=
# Convex dashboard → Settings → Deployment URL, e.g. https://abc-123.convex.cloud
CONVEX_URL=
# Same value as CONVEX_URL, exposed to the browser bundle.
NEXT_PUBLIC_CONVEX_URL=
# Same value as CONVEX_URL, exposed to the Expo bundle.
EXPO_PUBLIC_CONVEX_URL=
# Convex dashboard → Settings → HTTP Actions URL, e.g. https://abc-123.convex.site
# Better Auth mounts its routes here.
CONVEX_SITE_URL=
# Optional. Same value as CONVEX_SITE_URL, exposed to the Expo bundle. Leave blank
# for a hosted Convex deployment — apps/mobile derives it by swapping
# `.convex.cloud` for `.convex.site`. Set it explicitly when self-hosting or
# proxying Convex, where that convention does not hold.
EXPO_PUBLIC_CONVEX_SITE_URL=
# Convex dashboard → Settings → Deploy Keys. Only CI and Vercel builds need it.
CONVEX_DEPLOY_KEY=


# -----------------------------------------------------------------------------
# Better Auth — identity (organiser OTP, guest OAuth)
# -----------------------------------------------------------------------------

# Generate it yourself: `openssl rand -base64 32`. Minimum 32 characters, and it
# must be byte-identical in Convex, Vercel and .env.local or sessions break.
BETTER_AUTH_SECRET=
# Base URL Better Auth serves from — normally the same as CONVEX_SITE_URL.
BETTER_AUTH_URL=


# -----------------------------------------------------------------------------
# Google OAuth — guest + organiser sign-in on web and app
# -----------------------------------------------------------------------------

# Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client IDs →
# Web application. Add ${SITE_URL} and ${CONVEX_SITE_URL} as authorised origins
# and ${CONVEX_SITE_URL}/api/auth/callback/google as a redirect URI.
GOOGLE_CLIENT_ID=
# Same Google OAuth client → Client secret.
GOOGLE_CLIENT_SECRET=


# -----------------------------------------------------------------------------
# Sign in with Apple — app only (PLAN.md: no Apple web OAuth in beta)
# -----------------------------------------------------------------------------

# Apple Developer → Certificates, Identifiers & Profiles → Identifiers →
# Services IDs. This is the *web* identifier, e.g. com.partybooth.web
APPLE_CLIENT_ID=
# The iOS app bundle id, com.partybooth.app — native Sign in with Apple tokens
# carry this as their audience, so the backend must accept it too.
APPLE_APP_BUNDLE_IDENTIFIER=
# Apple Developer → Membership details → Team ID (10 characters).
APPLE_TEAM_ID=
# Apple Developer → Keys → your "Sign in with Apple" key → Key ID.
APPLE_KEY_ID=
# Contents of the AuthKey_<KEY_ID>.p8 you downloaded from Apple, as a single
# line with real newlines replaced by \n. Apple lets you download it once only.
APPLE_PRIVATE_KEY=


# -----------------------------------------------------------------------------
# Resend — six-digit OTP codes and co-host invites
# -----------------------------------------------------------------------------

# Resend dashboard → API Keys → Create API Key with sending permission.
# Starts with re_. Add the domain and its SPF/DKIM records first (DNS is slow).
RESEND_API_KEY=
# A mailbox on the Resend-verified domain, e.g. hello@partybooth.example
RESEND_FROM_EMAIL=
# Display name on outgoing mail. Optional; defaults to "PartyBooth".
RESEND_FROM_NAME=
# Set to 1 — local development only — to print the full body of an email that
# could not be sent, OTP code included, to the logs. Ignored unless
# DEPLOYMENT_ENVIRONMENT is development. Optional; defaults to 0.
EMAIL_DEBUG_LOG_CODES=


# -----------------------------------------------------------------------------
# UploadThing — private production storage; public local free-tier fallback
# -----------------------------------------------------------------------------

# UploadThing dashboard → your app → API Keys → the V7 token (a long base64
# string that already encodes the app id and region).
#
# Set the SAME value in TWO places: Vercel (the route handler that stores files)
# and the Convex dashboard (the mutations that mint signed read URLs and delete
# withdrawn files).
#
# A production app needs three dashboard settings, and they are not in this file
# because they are not variables — check them once, at UploadThing → your app:
#   * a paid plan,
#   * region pdx1 and default ACL **Private**,
#   * "allow per-request ACL override" ENABLED — the route handler declares
#     acl: "private" in code rather than inheriting the default, because an
#     invariant living in a checkbox is one a mis-click silently revokes.
#
# For local development on UploadThing's free tier, set UPLOADTHING_ACL to
# public-read. The web route refuses that ACL unless DEPLOYMENT_ENVIRONMENT was
# explicitly set to development; the uploaded object URLs are nevertheless
# public to anyone who obtains them.
#
# Unset = /api/uploadthing answers 503 naming this variable, and read paths
# return media with no URL. Nothing crashes; nothing uploads.
UPLOADTHING_TOKEN=
# UploadThing dashboard → app id. Optional — only set it if a tool asks for the
# id separately from the token.
UPLOADTHING_APP_ID=
# Object ACL. Keep private for preview/production. Local development may set
# public-read to use an UploadThing free-tier app; those object URLs are public.
UPLOADTHING_ACL=
# Region new events are created in. Beta supports "pdx1" only; stored per event
# as events.storageRegion. Optional; defaults to pdx1.
STORAGE_DEFAULT_REGION=
# Shared secret that proves an upload-completion call came from the apps/web
# UploadThing route handler, and not from a guest replaying the short-lived
# grant they were legitimately handed. Generate one with
#   openssl rand -base64 48
# and set the SAME value in Vercel (for the route handler) and in the Convex
# dashboard (for the mutation that checks it). At least 32 characters.
# Unset = completion callbacks are refused and uploads never leave `processing`.
UPLOAD_CALLBACK_SECRET=


# -----------------------------------------------------------------------------
# Sentry — error reporting. Every value is optional; unset = reporting disabled.
# -----------------------------------------------------------------------------

# Sentry → Projects → partybooth-server → Settings → Client Keys (DSN).
# Used by the Next.js server and Convex functions.
SENTRY_DSN=
# Sentry → Projects → partybooth-web → Client Keys (DSN). Browser bundle.
NEXT_PUBLIC_SENTRY_DSN=
# Sentry → Projects → partybooth-mobile → Client Keys (DSN). Expo bundle.
EXPO_PUBLIC_SENTRY_DSN=
# Environment tag on server events (development / preview / production).
# Optional; defaults to NODE_ENV.
SENTRY_ENVIRONMENT=
# Environment tag on browser events. Optional.
NEXT_PUBLIC_SENTRY_ENVIRONMENT=
# Sentry organisation slug — only needed to upload source maps during builds.
SENTRY_ORG=
# Sentry project slug — only needed to upload source maps during builds.
SENTRY_PROJECT=
# Sentry → Settings → Auth Tokens, scope project:releases. Build-time only:
# set it in Vercel and EAS, never in the browser.
SENTRY_AUTH_TOKEN=
# Sentry instance URL, read by apps/mobile/app.config.ts when it wires up
# source-map upload. Optional; only set it for self-hosted Sentry.
SENTRY_URL=


# -----------------------------------------------------------------------------
# Admin console (/admin) and App Review demo account
# -----------------------------------------------------------------------------

# Comma-separated emails allowed to sign in at /admin. Start with your own.
# Anything not on this list is refused before an OTP is even sent.
ADMIN_EMAIL_ALLOWLIST=
# Fixed reviewer account for Apple App Review, e.g. review@partybooth.example.
#
# Both variables must be set for the demo login to exist at all; either one
# alone does nothing. When unset, the code path returns `undefined` and there is
# no branch from an environment variable to a fixed code — a submitted code is
# still checked against Better Auth's hashed challenge, with the usual 10-minute
# expiry and 5-attempt limit. The gate is the two variables plus one address,
# and every use is audited as `auth.demo_sign_in`.
#
# UNSET ALL THREE ONCE THE BUILD IS APPROVED. Leaving them set leaves a known
# address with a known code on a production deployment — which is why the third
# variable is a hard expiry rather than a reminder, and why the demo identity is
# confined to the seeded demo party and refused every real event.
#
# (Some planning notes call these DEMO_ACCOUNT_EMAIL / DEMO_FIXED_OTP. The
# implemented names are these, validated in packages/env since Sprint 1.)
DEMO_LOGIN_EMAIL=
# The fixed six-digit code that account accepts instead of a real emailed OTP.
# Only meaningful together with DEMO_LOGIN_EMAIL.
DEMO_LOGIN_OTP=
# When the bypass switches itself off, ISO 8601 (e.g. 2026-09-01T00:00:00Z).
# REQUIRED: without it — or once it has passed, or if it will not parse — the
# demo login does not exist, exactly as if DEMO_LOGIN_OTP were unset. Set it
# about six weeks out so one resubmission fits inside the window.
DEMO_LOGIN_EXPIRES_AT=

# After setting all three on the deployment, seed the party the reviewer lands
# in (scripts/seed-demo.mjs):
#     bun run seed:demo                          # rows with no thumbnails
#     bun run seed:demo key_abc123 key_def456    # rows pointing at real objects
#     bun run seed:demo --prod key_abc123        # against the production deployment
# Asset keys are optional: they are UploadThing file keys for two or three
# innocuous images uploaded once by hand, and without them the demo party has
# rows but no thumbnails — a Convex mutation cannot put bytes into storage, and
# this is the one part of the demo the seeder cannot do for itself. Use --prod
# for the deployment App Review actually signs into.


# -----------------------------------------------------------------------------
# Universal links / App Links — what makes a scanned QR open the app
# -----------------------------------------------------------------------------
# apps/web serves /.well-known/apple-app-site-association and
# /.well-known/assetlinks.json from these values. Until they are set, those two
# URLs answer 404 and an https QR falls back to the mobile web page — which is
# the guaranteed guest path anyway, so this is a degradation, not an outage.
# A *wrong* association document is worse than a missing one: both platforms
# cache it, so fill these in from the real dashboards.
#
# iOS additionally needs APPLE_TEAM_ID and APPLE_APP_BUNDLE_IDENTIFIER above.

# Android application id — must match android.package in apps/mobile/app.config.ts.
# Optional; defaults to com.partybooth.app.
ANDROID_APP_PACKAGE=
# Play Console → your app → Setup → App signing → SHA-256 of the *app signing*
# certificate. Each fingerprint must be 32 colon-separated hex pairs, exactly as
# the Play Console prints it (AB:CD:…:EF — 95 characters). Case and surrounding
# whitespace are normalised for you; the colons are not optional, so a value
# pasted as one unbroken hex string is rejected at startup. Comma-separate
# several (add the upload key while you are testing internal builds, and Play's
# own key once the app is signed by Play).
ANDROID_CERT_FINGERPRINTS=


# -----------------------------------------------------------------------------
# Expo / EAS — push notifications and builds
# -----------------------------------------------------------------------------

# expo.dev → your project → Project ID (a UUID). Needed to send Expo push.
EAS_PROJECT_ID=
# Same UUID, exposed to the app so it can register for a push token.
EXPO_PUBLIC_EAS_PROJECT_ID=
# expo.dev → Account settings → Access tokens. Optional; enables enhanced push
# security and non-interactive EAS builds in CI.
EXPO_ACCESS_TOKEN=
# Expo account or organisation that owns the EAS project, read by
# apps/mobile/app.config.ts. Optional; unset until `eas init` has run.
EXPO_OWNER=


# -----------------------------------------------------------------------------
# `eas submit` — store credentials
# -----------------------------------------------------------------------------
# Read by the submit profiles in apps/mobile/eas.json, which reference these as
# $APPLE_ID / $ASC_APP_ID / $APPLE_TEAM_ID rather than hardcoding them: an App
# Store Connect app id in a committed file is somebody else's build target.
#
# Needed only when you run `eas submit`. `eas build` does not read them, so an
# unset value here never blocks a build — it fails at submit time with a clear
# message, which is the right place for it to fail.

# The Apple ID you sign in to App Store Connect with (an email address).
APPLE_ID=
# App Store Connect → your app → App Information → General Information →
# "Apple ID". A NUMERIC id (e.g. 6740000000), *not* the bundle identifier and
# not the email above — mixing these up is the usual first-submit failure.
ASC_APP_ID=
# APPLE_TEAM_ID is defined in the Apple section above and is reused here.

# Play Console → Setup → API access → service account JSON, saved to a path
# outside the repo. Only needed for `eas submit --platform android`.
GOOGLE_SERVICE_ACCOUNT_KEY_PATH=
